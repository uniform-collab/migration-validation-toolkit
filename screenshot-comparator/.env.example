PROD_WEBSITE_URL=
STAGE_WEBSITE_URL=
# JSON map: scope + item selectors (see selector-maps/). Optional removeBeforeScreenshot: list of CSS selectors removed before capture (e.g. cookie CMP roots).
SELECTOR_MAP_PATH=
# When 1/true/yes/on: save per-component innerText next to PNGs during screenshots, and compare those sidecars during diff (in addition to visual PNG diff).
ENABLE_CONTENT_COMPARISON=
# Max line length when printing innerText in content-diff logs (default 80; full text wrapped, not truncated).
INNER_TEXT_LOG_WRAP_WIDTH=
# Vercel deployment protection bypass (optional).
VERCEL_AUTOMATION_BYPASS_SECRET=
# Secret query param for restricted migrated/stage site access during screenshots (?is_visual_testing=true&secret=…).
VERCEL_PREVIEW_SECRET=
PIXEL_MATCH_THRESHOLD= # 0.0 to 1.0, lower is more strict

UNIFORM_API_KEY=
UNIFORM_PROJECT_ID=

SITEMAP_URL=
# Pipe-separated path patterns; * = one segment. Only the first N URLs per pattern are kept (see SITEMAP_DYNAMIC_SAMPLE_COUNT); other paths stay as in the sitemap.
# Also used by build:urls:diff — URLs matching any pattern are excluded from the urls.json vs urls-sitemap.json diff.
# Example: /news/childrens-hospitals-today/*/*/*|/content/pediatric-learning-solutions/article/*|/news/newsroom/*/*/*|/news/cha-blog/*/*/*
SITEMAP_DYNAMIC_SAMPLE_PATTERNS=
# How many sample URLs to keep for each dynamic pattern (default 2).
SITEMAP_DYNAMIC_SAMPLE_COUNT=

VISUAL_REGRESSION_EXCLUDE_RESULTS=[{"url":"/self-regulation","component":"div-03","percents":0.09}]