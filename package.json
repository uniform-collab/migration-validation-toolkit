{
  "name": "@uniformdev/migration-validation-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end validation toolkit for content migrations: crawls a legacy site and its migrated replacement, compares per-component innerText and screenshots, and reports the diff.",
  "bin": {
    "migration-validate": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"src/lib/**/*.test.mjs\"",
    "install-browsers": "node bin/cli.mjs install-browsers",
    "capture": "node bin/cli.mjs capture",
    "compare": "node bin/cli.mjs compare",
    "compare-screenshots": "node bin/cli.mjs compare-screenshots",
    "report": "node bin/cli.mjs report-viewer"
  },
  "keywords": [
    "migration",
    "validation",
    "e2e",
    "playwright",
    "visual-regression",
    "content-comparison",
    "uniform"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "playwright": "^1.54.0",
    "sharp": "^0.34.3"
  }
}
